{
  "name": "hunger-meter",
  "version": "1.0.0",
  "description": "A read-only analytics tool that scans directory trees and ranks directories by 'storage hunger' — how aggressively they consume disk space over time — using 14 statistical metrics and composite scoring. Built with Bun, zero runtime dependencies.",
  "homepage": "https://github.com/isurfer21/storage-hunger-meter#readme",
  "bugs": {
    "url": "https://github.com/isurfer21/storage-hunger-meter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://isurfer21@github.com/isurfer21/storage-hunger-meter.git"
  },
  "author": "Abhishek Kumar",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hunger-meter": "./index.ts"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "bun run --watch index.ts",
    "scan": "bun run index.ts --mode cli",
    "web": "bun run index.ts --mode web",
    "check": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "module": "index.ts"
}
